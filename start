#!/usr/bin/env bash
# Putanja i ime: ./start
# Verzija: 1.0.5

# Naziv virtualnog okruženja
VENV_DIR="knjige_env"

echo "=================================================="
echo "    MambaBookVoice v1.0.5 - Pokretanje sustava   "
echo "=================================================="

# 1. Provjera i automatska instalacija virtualnog okruženja (izolacija)
if [ ! -d "$VENV_DIR" ]; then
    echo "[INFO] Kreiram izolirano Python okruženje '$VENV_DIR'..."
    python -m venv "$VENV_DIR"
    
    echo "[INFO] Aktiviram okruženje i instaliram potrebne pakete..."
    source "$VENV_DIR/Scripts/activate"
    
    # Nadogradnja pip-a i instalacija potrebnih biblioteka
    pip install --upgrade pip
    pip install edge-tts pypdf python-docx ebooklib
    echo "[INFO] Instalacija uspješno završena."
else
    # Ako okruženje već postoji, aktiviraj ga
    source "$VENV_DIR/Scripts/activate"
    
    # Provjeri jesu li svi potrebni paketi instalirani
    echo "[INFO] Provjeravam instalirane pakete..."
    pip install --upgrade pip --quiet
    pip install edge-tts pypdf python-docx ebooklib --quiet
    echo "[INFO] Paketi su ažurni."
fi

# 2. Pokretanje glavne aplikacije i prosljeđivanje svih argumenata korisnika
python mamba_voice.py "$@"

# Deaktivacija virtualnog okruženja po završetku rada
deactivate